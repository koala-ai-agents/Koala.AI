{
  "koala_spec_version": 1,
  "flow_id": "summarize",
  "flow_version": "0.1.0",
  "dag_id": "koala_summarize",
  "input_key": "input",
  "tags": [
    "koala"
  ],
  "default_args": {
    "owner": "koala",
    "depends_on_past": false
  },
  "steps": [
    {
      "id": "summarize",
      "action_ref": "koala_flows.ollama_pipeline:summarizer",
      "args": {
        "input": "$input.topic"
      },
      "timeout": null,
      "retries": 0
    },
    {
      "id": "count",
      "action_ref": "koala_flows.ollama_pipeline:word_count",
      "args": {
        "text": "$result.summarize"
      },
      "timeout": null,
      "retries": 0
    }
  ],
  "edges": [
    [
      "summarize",
      "count"
    ]
  ]
}